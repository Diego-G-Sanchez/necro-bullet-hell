config_version=5

[application]

config/name="bullet-hell"
run/main_scene="uid://f1hxojdn368j"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://cg1et73vuc8pl"

[autoload]

Globals="*res://globals.tscn"
